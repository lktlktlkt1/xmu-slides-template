% SUSTech color theme for Gemini poster
% Adapted from beamercolorthemesustech.sty
% https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

\definecolor{sustechblue}{HTML}{2C5F7C}
\definecolor{sustechblue2}{HTML}{3A6F8C}
\definecolor{sustechdark}{HTML}{1A3F5C}
\definecolor{sustechorange}{HTML}{E67E22}
\definecolor{sustechlight}{HTML}{D6E2EA}
\definecolor{bgsoft}{HTML}{F5F7F8}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=sustechblue}

% Headline
\setbeamercolor{headline}{fg=white,bg=sustechblue}
\setbeamercolor{headline rule}{bg=sustechdark}

% Block
\setbeamercolor{block title}{fg=sustechblue,bg=white}
\setbeamercolor{block separator}{bg=sustechdark}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block title alerted}{fg=sustechorange,bg=sustechlight}
\setbeamercolor{block separator alerted}{bg=sustechorange}
\setbeamercolor{block body alerted}{fg=black,bg=sustechlight}

% Example Block
\setbeamercolor{block title example}{fg=sustechblue,bg=bgsoft}
\setbeamercolor{block separator example}{bg=sustechdark}
\setbeamercolor{block body example}{fg=black,bg=bgsoft}

% Heading
\setbeamercolor{heading}{fg=sustechdark}

% Itemize
\setbeamercolor{item}{fg=sustechblue}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
